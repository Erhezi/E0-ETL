# Secrets for this repo. Copy this file to .env and fill in real values.
# .env is gitignored; never commit real secrets.

# Which variables below hold secrets that must be encrypted at rest. Add a key
# here when you add a new app's secret, then re-run the setup/encrypt command.
SECRET_KEYS=CLIENT_SECRET,CLIENT_SECRET_FUTURE

# Microsoft Graph service-account credentials for the daily email report
# (the same app registration as A13-MedlinePBO).
TENANT_ID=your-tenant-id-here
CLIENT_ID=your-client-id-here
CLIENT_SECRET=your-client-secret-here

# After filling the secret values above, run:
#   python first_time_setup.py          # saves E0_SECRET_PASSPHRASE and encrypts them
# which rewrites each declared key into an encrypted, at-rest-safe line, e.g.:
#   CLIENT_SECRET_HASHED=enc::....
# env_secrets.load_env decrypts every enc:: value at runtime using the
# E0_SECRET_PASSPHRASE environment variable.
#
# Useful afterwards:
#   python -m infor_loader.env_secrets status         # what is plaintext vs encrypted
#   python -m infor_loader.env_secrets encrypt        # encrypt newly added keys
#   python -m infor_loader.env_secrets encrypt --keys SFTP_PASSWORD   # one-off override
